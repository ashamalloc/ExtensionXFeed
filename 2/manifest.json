{
  "manifest_version": 3,
  "name": "Twitter Feed Mirror",
  "version": "1.0",
  "description": "Mirror Twitter feeds between friends",
  "permissions": [
    "storage",
    "cookies",
    "scripting",
    "activeTab",
    "notifications",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.twitter.com/*", "*://*.x.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitter Feed Mirror"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}